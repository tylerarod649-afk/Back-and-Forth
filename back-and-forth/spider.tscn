[ext_resource type="Texture2D" uid="uid://df6menr4hh00a" path="res://Untitled Design (2)-transparent.png" id="1_qrebf"]

[sub_resource type="GDScript" id="GDScript_k3kcl"]
script/source = "extends Node2D

@export var speed: float = 120.0

@onready var character: Node2D = get_tree().get_first_node_in_group(\"player\")

func _process(delta: float) -> void:
	if character == null:
		return
	var direction = global_position.direction_to(character.global_position)
	global_position += direction * speed * delta
"

[node name="Spider" type="Node2D" unique_id=487454425]
